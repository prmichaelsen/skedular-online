{
  "name": "skedular",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 3322 --host",
    "build": "vite build",
    "serve": "vite preview",
    "typecheck": "tsc --noEmit",
    "cf-typegen": "wrangler types",
    "cf-secrets": "npm run wrangler -- versions secret put || tsx scripts/upload-cloudflare-secrets.ts",
    "cf-secrets:upload": "tsx scripts/upload-cloudflare-secrets.ts",
    "wrangler": "export $(cat .env.cloudflare.local | xargs) && wrangler",
    "env": "export $(cat .env.cloudflare.local | xargs)",
    "deploy": "npm run build && npm run wrangler -- deploy",
    "tail": "wrangler tail"
  },
  "dependencies": {
    "@cloudflare/vite-plugin": "^1.23.1",
    "@prmichaelsen/firebase-admin-sdk-v8": "^2.8.0",
    "@tailwindcss/vite": "^4.0.6",
    "@tanstack/react-router": "^1.132.0",
    "@tanstack/react-start": "^1.132.0",
    "@tanstack/router-plugin": "^1.132.0",
    "firebase": "^10.14.1",
    "firebase-admin": "^13.7.0",
    "lucide-react": "^0.577.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.0.6",
    "vite-tsconfig-paths": "^5.1.4",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260207.0",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^5.0.4",
    "tsx": "^4.21.0",
    "typescript": "^5.7.2",
    "vite": "^7.1.7"
  }
}
